generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  maintenanceLogs MaintenanceLog[]
  repairLogs      RepairLog[]
}

enum Role {
  ADMIN
  USER
}

model Device {
  id               String       @id @default(cuid())
  deviceCode       String       @unique
  name             String
  category         String
  manufacturer     String
  model            String
  ref              String?
  dealer           String?
  department       String?
  serialNumber     String?
  location         String
  purchaseDate     DateTime?
  usefulLifeYears  Int?
  price            Float?
  endOfSaleDate    DateTime?
  endOfServiceDate DateTime?
  warrantyExpiry   DateTime?
  status           DeviceStatus  @default(ACTIVE)
  disposalStatus   DisposalStatus?
  disposalDate     DateTime?
  inactiveDate     DateTime?
  notes            String?
  inspectionNotes  String?
  inspectionIntervalMonths Int?
  batteryReplacementIntervalYears Int?
  lastBatteryReplacementDate      DateTime?
  consumableName   String?
  lastConsumableReplacementDate       DateTime?
  lastConsumableSpareReplacementDate  DateTime?
  isCleanField              Boolean   @default(false)
  cleanFieldCategory        String?
  cleanFieldDefaultCount    Int?
  cleanFieldCurrentCount    Int?
  cleanFieldSubstituteCount Int?
  photoUrl         String?
  attachmentUrl         String?
  catalogUrl            String?
  manualUrl             String?
  pmdaApprovalNumber    String?
  pmdaDocUpdatedAt      String?
  pmdaLastCheckedAt     DateTime?
  pmdaUpdateAvailable   Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt        DateTime     @updatedAt

  maintenanceLogs     MaintenanceLog[]
  repairLogs          RepairLog[]
  inspectionSchedules InspectionSchedule[]
  inspectionItems     DeviceInspectionItem[]
  sterilizationChecks SterilizationCheck[]
}

model SterilizationCheck {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  inspectedBy String
  judgment    String
  notes       String?
  inspectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model InspectionTemplate {
  id        String                   @id @default(cuid())
  name      String
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  items     InspectionTemplateItem[]
}

model InspectionTemplateItem {
  id         String             @id @default(cuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  category   String             @default("外装・機能点検")
  lowerLimit Float?
  upperLimit Float?
  sortOrder  Int                @default(0)
  createdAt  DateTime           @default(now())
}

model DeviceInspectionItem {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name       String
  category   String   @default("外装・機能点検")
  lowerLimit Float?
  upperLimit Float?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
}

enum DisposalStatus {
  DISPOSED
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  MAINTENANCE
  REPAIR
  RETIRED
}

model InspectionSchedule {
  id           String    @id @default(cuid())
  deviceId     String
  device       Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  intervalDays Int
  description  String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  completedBy  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        InspectionItem[]
}

model InspectionItem {
  id             String             @id @default(cuid())
  scheduleId     String
  schedule       InspectionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name           String
  category       String             @default("外装・機能点検")
  lowerLimit     Float?
  upperLimit     Float?
  measuredValue  Float?
  judgment       String?
  createdAt      DateTime           @default(now())
}

model MaintenanceLog {
  id           String          @id @default(cuid())
  deviceId     String
  device       Device          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  performedBy  String
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  performedAt  DateTime
  type         MaintenanceType
  description  String
  result       String?
  nextSchedule DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

enum MaintenanceType {
  INSPECTION
  CALIBRATION
  CLEANING
  PREVENTIVE
  OTHER
}

model RepairLog {
  id         String       @id @default(cuid())
  deviceId   String
  device     Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  reportedBy String
  userId     String?
  user       User?        @relation(fields: [userId], references: [id])
  reportedAt DateTime
  symptom    String
  cause      String?
  action     String?
  resolvedAt DateTime?
  status     RepairStatus @default(OPEN)
  cost       Float?
  vendor     String?
  statusLogs RepairStatusLog[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model RepairStatusLog {
  id          String       @id @default(cuid())
  repairLogId String
  repairLog   RepairLog    @relation(fields: [repairLogId], references: [id], onDelete: Cascade)
  status      RepairStatus
  changedBy   String
  note        String?
  changedAt   DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([repairLogId])
}
