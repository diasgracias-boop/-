# ==================================================
# 医療機器管理システム 環境変数設定例
# このファイルを .env.local にコピーして値を入力してください
# ==================================================

# データベース接続URL（Neon等の無料クラウドPostgreSQLを推奨）
# 取得方法: https://neon.tech → New Project → Connection string をコピー
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# 認証シークレット（任意の長いランダム文字列）
NEXTAUTH_SECRET="ここに長いランダム文字列を入力"

# アプリのURL（ローカル動作確認時はそのまま）
NEXTAUTH_URL="http://localhost:3000"
